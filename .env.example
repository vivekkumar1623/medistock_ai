# =============================================================================
# MediStock AI - environment template
# Copy to `.env` and adjust. NEVER commit `.env` (it is git-ignored).
# Every variable is prefixed MEDISTOCK_ so it cannot silently collide with
# unrelated process environment variables.
# =============================================================================

# --- Application ---
MEDITSTOCK_APP_NAME="MediStock AI"
# development | test | production
MEDITSTOCK_ENVIRONMENT=development

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL
MEDITSTOCK_LOG_LEVEL=INFO
# true -> one JSON object per line (for container/aggregator ingestion)
MEDITSTOCK_LOG_JSON=false

# --- Reproducibility ---
# Single seed threaded through data generation, splitting and model fitting.
MEDITSTOCK_RANDOM_SEED=42

# --- Paths (relative to repository root unless absolute) ---
MEDITSTOCK_DATA_DIR=data
MEDITSTOCK_ARTIFACT_DIR=artifacts
# Which artifacts/<version>/ directory the API and dashboard load.
MEDITSTOCK_ARTIFACT_VERSION=v1

# --- Database ---
MEDITSTOCK_DB_URL=sqlite:///./data/medistock.db

# --- Dashboard -> API wiring ---
MEDITSTOCK_API_BASE_URL=http://127.0.0.1:8000
MEDITSTOCK_API_TIMEOUT_SECONDS=30

# --- Forecasting contract ---
# Prediction target = total product demand over the next N days.
MEDITSTOCK_FORECAST_HORIZON_DAYS=30

# --- Expiry-risk policy (documented rule, not a magic label) ---
# A batch is at risk when FEFO-allocatable forecast demand before expiry
# is less than the batch remaining quantity.
MEDITSTOCK_RISK_CRITICAL_DAYS=30
MEDITSTOCK_RISK_HIGH_DAYS=60
MEDITSTOCK_RISK_MEDIUM_DAYS=90
