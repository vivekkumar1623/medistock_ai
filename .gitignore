# --- Secrets ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# --- Data (regenerated by scripts/generate_data.py; never hand-edited) ---
data/raw/*
data/processed/*
data/interim/*
data/*.db
data/*.db-journal
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/interim/.gitkeep

# --- Artifacts ---
# The curated artifacts/<version>/ bundle IS committed so that the demo and
# the acceptance test "load saved model and predict" work on a fresh clone.
artifacts/tmp/
artifacts/**/*.tmp
*.joblib.tmp

# --- Reports / notebooks ---
reports/logs/*
!reports/logs/.gitkeep
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
